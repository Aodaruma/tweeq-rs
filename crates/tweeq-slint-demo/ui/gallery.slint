import { Button, CheckBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { TweeqNumber, TweeqAngle, TweeqColor, TweeqNumberView, TweeqColorView } from "@tweeq";
export { TweeqAction, TweeqBridge, TweeqChannel, TweeqColorView, TweeqInput, TweeqNumberView } from "@tweeq";

export struct GalleryRow {
    label: string,
    description: string,
    number: TweeqNumberView,
    angle: bool,
    rotation: float,
}

export component Gallery inherits Window {
    title: "Tweeq Slint Gallery";
    preferred-width: 660px;
    preferred-height: 655px;
    min-width: 310px;
    min-height: 320px;
    background: light ? #f8f9fc : #171a22;

    in-out property <[GalleryRow]> rows;
    in property <TweeqColorView> color-a;
    in property <TweeqColorView> color-b;
    in property <string> event-log: "Ready";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <bool> light;
    in-out property <bool> unbounded;
    in property <string> pointer-status;
    callback undo();
    callback redo();

    ScrollView {
        VerticalBox {
            padding: 18px;
            spacing: 12px;
            Text {
                text: "Tweeq / Slint";
                color: root.light ? #202530 : #f2f4f8;
                font-size: 26px;
                font-weight: 700;
            }
            Text {
                text: "Drag to adjust. Click to type. Ctrl-click or Shift-click to select multiple fields.";
                color: root.light ? #343c4f : #b4bdcf;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
                Button { text: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
                Button { text: root.light ? "Dark theme" : "Light theme"; clicked => { root.light = !root.light; } }
            }
            HorizontalLayout {
                spacing: 8px;
                CheckBox { text: "Unlimited relative drag"; checked <=> root.unbounded; }
                Text {
                    text: root.pointer-status;
                    color: root.light ? #343c4f : #b4bdcf;
                    vertical-alignment: center;
                }
            }
            for row in root.rows: VerticalLayout {
                spacing: 4px;
                Text { text: row.label; color: root.light ? #202530 : #f2f4f8; font-weight: 600; }
                if !row.angle: TweeqNumber { view: row.number; light: root.light; }
                if row.angle: TweeqAngle { view: row.number; rotation: row.rotation; light: root.light; }
                Text { text: row.description; color: root.light ? #343c4f : #b4bdcf; wrap: word-wrap; }
            }
            Text { text: "Colors"; color: root.light ? #202530 : #f2f4f8; font-weight: 600; }
            TweeqColor { view: root.color-a; light: root.light; }
            TweeqColor { view: root.color-b; light: root.light; }
            Text {
                text: "Click a swatch for the picker. Enter RGB or RGBA hex to set a color.";
                color: root.light ? #343c4f : #b4bdcf;
                wrap: word-wrap;
            }
            Text {
                text: root.event-log;
                color: root.light ? #343c4f : #b4bdcf;
                wrap: word-wrap;
            }
        }
    }
}
