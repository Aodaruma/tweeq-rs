export enum TweeqAction {
    select, begin-text, commit-text, begin-number, begin-rotary, move, modifiers, finish, cancel, reset,
    begin-color, begin-relative-color, preview-channel, preview-sv, finish-color, set-channel, set-hex,
}

export enum TweeqChannel {
    red, green, blue, alpha, hue, saturation, value,
}

export enum TweeqColorMode {
    saturation-value, alpha, hue, saturation, value, red, green, blue,
}

export struct TweeqInput {
    key: string,
    action: TweeqAction,
    x: float,
    y: float,
    width: float,
    height: float,
    dx: float,
    dy: float,
    text: string,
    shift: bool,
    alt: bool,
    snap: bool,
    control: bool,
    channel: TweeqChannel,
    capture: bool,
    color-mode: TweeqColorMode,
}

export struct TweeqNumberView {
    key: string,
    display: string,
    edit-text: string,
    fraction: float,
    bounded: bool,
    selected: bool,
}

export struct TweeqColorView {
    key: string,
    rgba: color,
    pure-hue: color,
    hex: string,
    red: float,
    green: float,
    blue: float,
    alpha: float,
    hue: float,
    saturation: float,
    value: float,
    selected: bool,
}

export global TweeqBridge {
    callback input(TweeqInput) -> bool;
}
