import { TweeqNumber, TweeqAngle, TweeqColor, TweeqNumberView, TweeqColorView } from "@tweeq";
export { TweeqAction, TweeqBridge, TweeqNumberView, TweeqColorView } from "@tweeq";

export component Consumer inherits Window {
    title: "External Tweeq consumer";
    width: 320px;
    height: 445px;
    in property <TweeqNumberView> model;
    in property <TweeqNumberView> angle-model;
    in property <float> degrees;
    in property <TweeqColorView> color-model;

    TweeqNumber {
        x: 20px;
        y: 20px;
        width: 240px;
        height: 28px;
        view: root.model;
    }

    TweeqAngle {
        x: 20px;
        y: 64px;
        width: 38px;
        view: root.angle-model;
        rotation: root.degrees;
    }

    TweeqColor {
        x: 20px;
        y: 105px;
        width: 240px;
        view: root.color-model;
    }
}
